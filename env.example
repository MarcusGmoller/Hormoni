# Supabase (already in use)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#
# Authentication → URL Configuration → Redirect URLs skal inkludere (tilpas host/port):
#   http://localhost:3000/auth/oauth/user              (Google som patient — påkrævet)
#   http://localhost:3000/auth/callback/professional
#   http://localhost:3000/auth/confirm
# Valgfrit (ældre server-callbacks): user-signin, user-signup, user

# Google Calendar API — videokonsultation (service account)
# 1) Opret service account i Google Cloud, download JSON-nøgle
# 2) Aktivér "Google Calendar API" for projektet
# 3) Del den ønskede kalender med service account-email (eller brug domain-wide delegation)
#
# GOOGLE_CALENDAR_CLIENT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=primary
# Valgfrit: Workspace — impersonér en bruger der ejer kalenderen
# GOOGLE_CALENDAR_IMPERSONATE=laegen@ditdomaene.dk
# Valgfrit:
# GOOGLE_CALENDAR_TIMEZONE=Europe/Copenhagen
